# Copy to .env on the server and edit.

# Image built by GitHub Actions (lower case, no .git): ghcr.io/<github-user>/<repo>
IMAGE=ghcr.io/your-github-user/linkvault
IMAGE_TAG=latest

# Public hostname (DNS A record -> VPS IP)
APP_DOMAIN=links.example.com

# Your Traefik setup (see README step 3)
TRAEFIK_NETWORK=root_default
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=mytlschallenge

APP_TITLE=LinkVault

# Comma-separated usernames that can open /admin (moderation). Register the account first.
ADMIN_USERNAMES=

# Optional but recommended: Google Safe Browsing API key for malware/phishing reputation checks
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# Days before anonymous (no-login) share links expire
ANON_SHARE_DAYS=30
